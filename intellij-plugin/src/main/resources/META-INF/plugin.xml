<idea-plugin>
    <id>io.github.enummapper.ide</id>
    <name>Enum Mapper</name>
    <vendor>Pavel Flegr</vendor>

    <description><![CDATA[
        Provides live validation for Enum Mapper calls in Kotlin source files.
        Gradle compilation remains responsible for generated mapping code.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
            language="kotlin"
            shortName="EnumMapperMapping"
            displayName="Invalid Enum Mapper mapping"
            groupName="Enum Mapper"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="io.github.enummapper.intellij.EnumMapperMappingInspection" />
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="false" supportsK2="true" />
    </extensions>
</idea-plugin>
